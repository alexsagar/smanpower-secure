// ============================================================
// Seven Seas Intercontinental — Database Schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

enum AccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
  PASSWORD_RESET_REQUIRED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  isActive      Boolean   @default(true)

  accountStatus      AccountStatus @default(ACTIVE)
  sessionVersion     Int           @default(1)
  passwordChangedAt  DateTime?
  mfaEnabled         Boolean       @default(false)
  mfaVerifiedAt      DateTime?
  mfaSecretEncrypted String?
  mfaKeyVersion      Int           @default(1)
  lastLoginAt        DateTime?
  lastLoginIpHash    String?
  failedLoginCount   Int           @default(0)
  lockedUntil        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role   Role   @relation(fields: [roleId], references: [id])
  roleId String

  accounts  Account[]
  sessions  Session[]
  auditLogs AuditLog[]

  resetTokens      PasswordResetToken[]
  mfaRecoveryCodes MfaRecoveryCode[]
  mfaChallenges    MfaChallenge[]
  adminSessions    AdminSession[]

  assignedLeads   EmployerLead[]       @relation("AssignedRecruiter")
  leadNotes       EmployerLeadNote[]
  articleAuthor   InsightArticle[]     @relation("ArticleAuthor")
  articleReviewer InsightArticle[]     @relation("ArticleReviewer")
  newsAuthor      NewsArticle[]        @relation("NewsAuthor")
  newsReviewer    NewsArticle[]        @relation("NewsReviewer")
  revisions       CmsContentRevision[] @relation("RevisionsAuthor")
  demandsCreated  Demand[]             @relation("DemandCreator")
  demandsUpdated  Demand[]             @relation("DemandUpdater")

  @@index([email])
  @@index([roleId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  adminInvitations AdminInvitation[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  module      String // e.g. "jobs", "leads", "content", "users"
  action      String // e.g. "create", "read", "update", "delete"
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([module, action])
  @@index([module])
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  @@id([roleId, permissionId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ============================================================

model AdminInvitation {
  id          String    @id @default(cuid())
  email       String    @unique
  roleId      String
  tokenHash   String
  expiresAt   DateTime
  usedAt      DateTime?
  sentAt      DateTime?
  createdById String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  role Role @relation(fields: [roleId], references: [id])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RateLimit {
  id         String   @id @default(cuid())
  identifier String // e.g. "contact_form:hash(ip)"
  points     Int      @default(0)
  expiresAt  DateTime

  @@index([identifier])
  @@index([expiresAt])
}

model MfaChallenge {
  id             String   @id @default(cuid())
  userId         String
  tokenHash      String   @unique
  expiresAt      DateTime
  ipHash         String?
  userAgentHash  String?
  failedAttempts Int      @default(0)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@unique([userId])
}

model AdminSession {
  id                    String    @id @default(cuid())
  sessionIdHash         String    @unique
  userId                String
  sessionVersionAtIssue Int
  createdAt             DateTime  @default(now())
  lastActivityAt        DateTime  @default(now())
  idleExpiresAt         DateTime
  absoluteExpiresAt     DateTime
  revokedAt             DateTime?
  revokedReason         String?
  ipAddressHash         String?
  userAgentHash         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
  @@index([revokedAt])
}

// EMPLOYER LEADS
// ============================================================

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  CLOSED
  LOST
}

model EmployerLead {
  id                   String    @id @default(cuid())
  companyName          String
  contactPerson        String
  designation          String?
  businessEmail        String
  phone                String
  country              String
  industry             String
  workforceCategory    String?
  numberOfWorkers      Int?
  requiredSkills       String?
  expectedMobilisation DateTime?
  message              String?
  consentGiven         Boolean   @default(false)
  source               String? // e.g. "website", "referral", "direct"

  status       LeadStatus @default(NEW)
  followUpDate DateTime?
  closedAt     DateTime?
  closedReason String?

  assignedRecruiter   User?   @relation("AssignedRecruiter", fields: [assignedRecruiterId], references: [id])
  assignedRecruiterId String?

  notes EmployerLeadNote[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([assignedRecruiterId])
}

model EmployerLeadNote {
  id        String       @id @default(cuid())
  content   String
  lead      EmployerLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String
  author    User         @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime     @default(now())

  @@index([leadId])
}

// ============================================================
// JOBS
// ============================================================

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  EXPIRED
  ARCHIVED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
}

model Job {
  id               String  @id @default(cuid())
  title            String
  slug             String  @unique
  description      String
  requirements     String?
  benefits         String?
  responsibilities String?

  country    Country  @relation(fields: [countryId], references: [id])
  countryId  String
  industry   Industry @relation(fields: [industryId], references: [id])
  industryId String

  employerName     String?
  showEmployerName Boolean        @default(false)
  salary           String?
  showSalary       Boolean        @default(false)
  contractPeriod   String?
  employmentType   EmploymentType @default(FULL_TIME)

  experienceRequired String?
  skillsRequired     String?
  educationRequired  String?
  languageRequired   String?
  documentsRequired  String?
  interviewDate      DateTime?
  deadline           DateTime?

  status     JobStatus @default(DRAFT)
  isFeatured Boolean   @default(false)
  vacancies  Int       @default(1)

  // Fee transparency
  feeNotice    String?
  safetyNotice String?

  // SEO
  metaTitle       String?
  metaDescription String?

  applications JobApplication[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([status])
  @@index([countryId])
  @@index([industryId])
  @@index([deadline])
  @@index([slug])
}

// ============================================================
// DEMANDS — International Manpower Demand Management
// ============================================================

enum DemandStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum FacilityStatus {
  PROVIDED
  NOT_PROVIDED
  ALLOWANCE_PROVIDED
  NOT_SPECIFIED
}

enum OvertimeStatus {
  YES
  NO
  NOT_SPECIFIED
}

enum PositionStatus {
  OPEN
  CLOSED
  FILLED
  ON_HOLD
}

enum DocumentVisibility {
  PUBLIC
  PRIVATE
}

enum DocumentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PassportStatus {
  VALID
  EXPIRED_OR_EXPIRING
  NO_PASSPORT
}

model Demand {
  id   String @id @default(cuid())
  slug String @unique

  // Company info
  title           String
  companyName     String
  companyLogoId   String?
  companyLogo     MediaAsset? @relation("DemandCompanyLogo", fields: [companyLogoId], references: [id])
  featuredImageId String?
  featuredImage   MediaAsset? @relation("DemandFeaturedImage", fields: [featuredImageId], references: [id])
  industryId      String?
  industry        Industry?   @relation(fields: [industryId], references: [id])
  countryId       String
  country         Country     @relation(fields: [countryId], references: [id])
  city            String?
  employerAddress String?

  // Demand reference
  demandReferenceNumber String?
  approvalDate          DateTime?
  receivedDate          DateTime?

  // Dates
  applicationStartDate DateTime?
  applicationDeadline  DateTime?
  interviewDate        DateTime?
  interviewLocation    String?
  contractType         String?

  // Content
  generalNotes String?

  // Status & visibility
  status   DemandStatus @default(DRAFT)
  isPublic Boolean      @default(false)

  // Application settings
  enableApplication              Boolean @default(true)
  requiredApplicationDocuments   String? // CSV or JSON of required doc types
  candidateInstructions          String?
  feeTransparencyNotice          String?
  candidateSafetyNotice          String?
  contactPerson                  String?
  contactPhone                   String?
  contactWhatsapp                String?
  applicationConfirmationMessage String?

  // SEO
  seoTitle        String?
  metaDescription String?
  ogImageUrl      String?
  canonicalUrl    String?

  // Lifecycle
  publishedAt DateTime?
  closedAt    DateTime?

  // Audit
  createdById String?
  createdBy   User?   @relation("DemandCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("DemandUpdater", fields: [updatedById], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  positions            DemandPosition[]
  documents            DemandDocument[]
  applications         DemandApplication[]
  documentRequirements ApplicationDocumentRequirement[]

  @@index([slug])
  @@index([status])
  @@index([countryId])
  @@index([industryId])
  @@index([applicationDeadline])
  @@index([isPublic, status])
}

model DemandPosition {
  id       String @id @default(cuid())
  demandId String
  demand   Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)

  displayOrder Int    @default(0)
  title        String

  // Manpower counts
  maleCount   Int?
  femaleCount Int?
  totalCount  Int  @default(1)

  // Qualifications
  minimumQualification String?
  requiredExperience   String?
  requiredSkills       String?

  // Salary
  salaryCurrency String? // e.g. "QAR", "AED", "SAR"
  salaryAmount   String? // Stored as string for flexibility (ranges, etc.)
  nprEquivalent  String? // Manually entered NPR equivalent

  // Working conditions
  overtimeStatus  OvertimeStatus @default(NOT_SPECIFIED)
  overtimeNotes   String?
  workHoursPerDay String?
  workDaysPerWeek String?
  annualLeave     String?

  // Facilities
  foodFacilityStatus  FacilityStatus @default(NOT_SPECIFIED)
  foodFacilityNotes   String?
  accommodationStatus FacilityStatus @default(NOT_SPECIFIED)
  accommodationNotes  String?

  // Contract
  contractPeriod String?
  otherBenefits  String?

  // Position-specific overrides
  deadlineOverride DateTime?
  status           PositionStatus @default(OPEN)
  isPublic         Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications         DemandApplication[]
  documentRequirements ApplicationDocumentRequirement[]

  @@index([demandId])
  @@index([status])
}

model DemandDocument {
  id       String @id @default(cuid())
  demandId String
  demand   Demand @relation(fields: [demandId], references: [id], onDelete: Cascade)

  mediaAssetId String?
  mediaAsset   MediaAsset? @relation("DemandDocumentMedia", fields: [mediaAssetId], references: [id])

  documentType   String // "demand_notice", "demand_letter", "demand_table", "pdf_document", "company_logo", "supporting_image"
  title          String?
  description    String?
  issueDate      DateTime?
  expiryDate     DateTime?
  visibility     DocumentVisibility     @default(PUBLIC)
  approvalStatus DocumentApprovalStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([demandId])
  @@index([documentType])
}

model DemandApplication {
  id         String          @id @default(cuid())
  demand     Demand          @relation(fields: [demandId], references: [id])
  demandId   String
  position   DemandPosition? @relation(fields: [positionId], references: [id])
  positionId String?

  // Candidate link (reuses existing CandidateProfile)
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id])
  candidateId String

  // Snapshot of what they applied for
  demandTitle  String?
  companyName  String?
  countryName  String?
  positionName String?

  // Application-specific fields
  passportStatus        PassportStatus?
  availableForInterview Boolean         @default(true)
  cvFileUrl             String?
  certificateFileUrl    String?
  provinceSnapshot      String?
  districtSnapshot      String?
  education             String?
  experience            String?
  skills                String?
  possibleDuplicate     Boolean         @default(false)

  // Consent
  demandDetailsRead     Boolean @default(false)
  privacyConsentGiven   Boolean @default(false)
  safetyAcknowledgement Boolean @default(false)

  privacyPolicyVersion String?
  consentTimestamp     DateTime?
  safetyAckTimestamp   DateTime?
  feeAckTimestamp      DateTime?
  formLanguage         String?
  applicationSource    String?
  hashedIp             String?
  hashedUserAgent      String?

  // Processing
  status        ApplicationStatus @default(SUBMITTED)
  adminNotes    String?
  statusHistory Json? // Array of { status, date, note }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([demandId, candidateId, positionId])
  @@index([demandId])
  @@index([candidateId])
  @@index([positionId])
  @@index([status])
}

// ============================================================
// CANDIDATES
// ============================================================

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  SELECTED
  REJECTED
  WITHDRAWN
}

model JobApplication {
  id            String            @id @default(cuid())
  job           Job               @relation(fields: [jobId], references: [id])
  jobId         String
  candidate     CandidateProfile  @relation(fields: [candidateId], references: [id])
  candidateId   String
  status        ApplicationStatus @default(SUBMITTED)
  coverLetter   String?
  adminNotes    String?
  statusHistory Json? // Array of { status, date, note }
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([jobId, candidateId])
  @@index([jobId])
  @@index([candidateId])
  @@index([status])
}

model CandidateProfile {
  id                  String    @id @default(cuid())
  fullName            String
  phone               String
  email               String
  address             String?
  province            String?
  district            String?
  dateOfBirth         DateTime?
  educationLevel      String?
  workExperience      String?
  skillCategory       String?
  preferredCountry    String?
  previousOverseasExp Boolean   @default(false)
  languageSkills      String?

  applications       JobApplication[]
  demandApplications DemandApplication[]
  documents          CandidateDocument[]
  consents           CandidateConsent[]
  trainingRecords    TrainingRecord[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([email])
  @@index([phone])
}

enum DocumentStatus {
  PENDING_SCAN
  SCANNING
  SAFE
  REJECTED
  SCAN_FAILED
}

enum DocumentType {
  CV
  PASSPORT_COPY
  TRADE_CERTIFICATE
  TRAINING_CERTIFICATE
  PHOTO
  DRIVING_LICENSE
  OTHER_APPROVED_DOCUMENT
}

model ApplicationDocumentRequirement {
  id         String          @id @default(cuid())
  demandId   String?
  demand     Demand?         @relation(fields: [demandId], references: [id], onDelete: Cascade)
  positionId String?
  position   DemandPosition? @relation(fields: [positionId], references: [id], onDelete: Cascade)

  documentType     DocumentType
  required         Boolean      @default(false)
  maxSizeMb        Int          @default(5)
  allowedMimeTypes String // e.g. "application/pdf,image/jpeg,image/png"
  instructions     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([demandId])
  @@index([positionId])
}

model CandidateDocument {
  id           String           @id @default(cuid())
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId  String
  documentType String // e.g. "cv", "passport", "certificate"
  fileName     String
  fileUrl      String // Private storage URL
  fileSize     Int?
  mimeType     String?
  isPrivate    Boolean          @default(true)
  status       DocumentStatus   @default(PENDING_SCAN)
  uploadedAt   DateTime         @default(now())

  @@index([candidateId])
  @@index([documentType])
}

model CandidateConsent {
  id           String           @id @default(cuid())
  candidate    CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  candidateId  String
  consentType  String // e.g. "data_processing", "privacy_policy", "application_terms"
  consentGiven Boolean
  consentDate  DateTime         @default(now())
  ipAddress    String?
  userAgent    String?

  @@index([candidateId])
}

// ============================================================
// REFERENCE DATA
// ============================================================

model Industry {
  id            String  @id @default(cuid())
  name          String  @unique
  nameNe        String? // Nepali name
  slug          String  @unique
  description   String?
  descriptionNe String?
  icon          String? // Icon identifier
  image         String? // Image URL
  order         Int     @default(0)
  isActive      Boolean @default(true)

  jobs           Job[]
  demands        Demand[]
  successStories SuccessStory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Country {
  id        String  @id @default(cuid())
  name      String  @unique
  nameNe    String? // Nepali name
  code      String  @unique // ISO 3166-1 alpha-2
  flagEmoji String?
  isActive  Boolean @default(true)

  jobs           Job[]
  demands        Demand[]
  successStories SuccessStory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

// ============================================================
// TRAINING
// ============================================================

model TrainingProgramme {
  id            String  @id @default(cuid())
  name          String
  nameNe        String?
  slug          String  @unique
  description   String?
  descriptionNe String?
  duration      String? // e.g. "2 weeks", "45 days"
  industry      String?
  skillLevel    String? // e.g. "beginner", "intermediate", "advanced"
  isActive      Boolean @default(true)

  records    TrainingRecord[]
  facility   TrainingFacility? @relation(fields: [facilityId], references: [id])
  facilityId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model TrainingFacility {
  id            String  @id @default(cuid())
  name          String
  nameNe        String?
  slug          String  @unique
  description   String?
  descriptionNe String?
  location      String?
  capacity      Int?
  images        Json? // Array of image URLs
  isActive      Boolean @default(true)

  programmes TrainingProgramme[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model TrainingRecord {
  id          String            @id @default(cuid())
  candidate   CandidateProfile  @relation(fields: [candidateId], references: [id])
  candidateId String
  programme   TrainingProgramme @relation(fields: [programmeId], references: [id])
  programmeId String
  startDate   DateTime?
  endDate     DateTime?
  status      String            @default("enrolled") // enrolled, in_progress, completed, dropped
  score       Float?
  certificate String? // Certificate URL
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([candidateId])
  @@index([programmeId])
  @@index([status])
}

// ============================================================
// COMPLIANCE & TRUST
// ============================================================

model ComplianceDocument {
  id               String    @id @default(cuid())
  title            String
  titleNe          String?
  description      String?
  descriptionNe    String?
  documentType     String // e.g. "licence", "certificate", "policy"
  issueDate        DateTime?
  expiryDate       DateTime?
  fileUrl          String?
  isPublic         Boolean   @default(false)
  isVerified       Boolean   @default(false)
  verificationNote String?
  order            Int       @default(0)
  lastUpdated      DateTime?
  versionHistory   Json? // Array of { version, date, changes }

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([documentType])
  @@index([isPublic])
  @@index([expiryDate])
}

model Certification {
  id                String    @id @default(cuid())
  name              String
  nameNe            String?
  issuingBody       String?
  certificateNumber String?
  issueDate         DateTime?
  expiryDate        DateTime?
  imageUrl          String?
  fileUrl           String?
  isPublic          Boolean   @default(false)
  isVerified        Boolean   @default(false)
  order             Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PolicyDocument {
  id            String    @id @default(cuid())
  title         String
  titleNe       String?
  slug          String    @unique
  content       String // Rich text / markdown
  contentNe     String?
  category      String? // e.g. "privacy", "worker_welfare", "recruitment"
  effectiveDate DateTime?
  version       String?
  isPublic      Boolean   @default(true)
  order         Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([category])
}

// ============================================================
// CONTENT
// ============================================================

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CareerOpeningStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum StoryType {
  CANDIDATE
  EMPLOYER
  TRAINING
  ETHICAL_RECRUITMENT
}


model SuccessStory {
  id             String    @id @default(cuid())
  title          String
  titleNe        String?
  slug           String    @unique
  summary        String?
  summaryNe      String?
  content        String
  contentNe      String?
  storyType      StoryType @default(CANDIDATE)
  
  featuredImageId String?
  featuredImage   MediaAsset? @relation("SuccessStoryImage", fields: [featuredImageId], references: [id])
  
  quote          String?
  
  industry       Industry? @relation(fields: [industryId], references: [id])
  industryId     String?
  country        Country?  @relation(fields: [countryId], references: [id])
  countryId      String?
  storyDate      DateTime?
  personName     String?
  showPersonName Boolean   @default(false)
  
  consentConfirmed Boolean   @default(false)
  consentNotes     String?
  
  status         ContentStatus @default(DRAFT)
  isFeatured     Boolean       @default(false)

  // SEO & Metadata
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  ogTitle         String?
  ogDescription   String?
  noIndex         Boolean?      @default(false)
  internalNotes   String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([slug])
  @@index([storyType])
  @@index([status])
}

model Testimonial {
  id           String  @id @default(cuid())
  personName   String
  designation  String?
  companyName  String?
  content      String
  contentNe    String?
  image        String?
  rating       Int? // 1-5
  storyType    String  @default("employer") // "candidate" or "employer"
  consentGiven Boolean @default(false)
  isPublished  Boolean @default(false)
  order        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PartnerCategory {
  PARTNER
  GROUP_COMPANY
  CLIENT
  EMPLOYER
}

model ClientPartner {
  id           String    @id @default(cuid())
  name         String
  category     PartnerCategory @default(PARTNER)
  logoUrl      String?
  website      String?
  country      String?
  industry     String?
  partnerSince DateTime?
  isPublic     Boolean   @default(false)
  isVerified   Boolean   @default(false)
  order        Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// WORKFORCE INTELLIGENCE
// ============================================================

model WorkforceDataset {
  id          String    @id @default(cuid())
  name        String
  description String?
  dataSource  String?
  sampleSize  Int?
  methodology String?
  lastUpdated DateTime?
  isPublic    Boolean   @default(false)

  metrics WorkforceMetric[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkforceMetric {
  id        String           @id @default(cuid())
  dataset   WorkforceDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  datasetId String
  category  String // e.g. "province", "industry", "skill", "age_group"
  label     String // e.g. "Province 1", "Construction", "18-25"
  value     Float
  unit      String? // e.g. "count", "percentage"
  period    String? // e.g. "2024-Q1"
  order     Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([datasetId])
  @@index([category])
}

// ============================================================
// ARTICLES & NEWS
// ============================================================

model ArticleCategory {
  id     String  @id @default(cuid())
  name   String  @unique
  nameNe String?
  slug   String  @unique
  order  Int     @default(0)

  insights InsightArticle[]
  news     NewsArticle[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model InsightArticle {
  id               String           @id @default(cuid())
  title            String
  titleNe          String?
  slug             String           @unique
  lang             String           @default("en")
  summary          String?
  summaryNe        String?
  content          String
  contentNe        String?
  
  featuredImageId  String?
  featuredImage    MediaAsset?      @relation("InsightImage", fields: [featuredImageId], references: [id])
  
  category         ArticleCategory? @relation(fields: [categoryId], references: [id])
  categoryId       String?
  tags             String[]
  
  author           User?            @relation("ArticleAuthor", fields: [authorId], references: [id])
  authorId         String?
  reviewer         User?            @relation("ArticleReviewer", fields: [reviewerId], references: [id])
  reviewerId       String?
  
  publishDate      DateTime?
  lastUpdated      DateTime?
  status           ContentStatus    @default(DRAFT)
  isFeatured       Boolean          @default(false)
  faqSection       Json? // Array of { question, answer }
  sourceReferences Json? // Array of { title, url }
  relatedContent   Json? // Array of article IDs

  // SEO & Content
  metaTitle       String?
  metaDescription String?
  focusKeyword    String?
  canonicalUrl    String?
  ogImage         String?
  ogTitle         String?
  ogDescription   String?
  noIndex         Boolean?      @default(false)
  readingTime     String?
  internalNotes   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([publishDate])
}

model NewsArticle {
  id               String           @id @default(cuid())
  title            String
  titleNe          String?
  slug             String           @unique
  lang             String           @default("en")
  summary          String?
  summaryNe        String?
  content          String
  contentNe        String?
  featuredImage    String?
  featuredImageId  String?
  featuredMedia    MediaAsset?      @relation("NewsImage", fields: [featuredImageId], references: [id])
  category         ArticleCategory? @relation(fields: [categoryId], references: [id])
  categoryId       String?
  author           User?            @relation("NewsAuthor", fields: [authorId], references: [id])
  authorId         String?
  reviewer         User?            @relation("NewsReviewer", fields: [reviewerId], references: [id])
  reviewerId       String?
  publishDate      DateTime?
  newsType         String?
  lastUpdated      DateTime?
  isPublished      Boolean          @default(false)
  status           ContentStatus    @default(DRAFT)
  isFeatured       Boolean          @default(false)
  sourceReferences Json?

  // SEO
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  ogImage         String?
  noIndex         Boolean          @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([categoryId])
  @@index([isPublished])
  @@index([status])
  @@index([publishDate])
}

model CareerOpening {
  id              String              @id @default(cuid())
  title           String
  slug            String              @unique
  lang            String              @default("en")
  department      String?
  location        String?
  employmentType  String?
  description     String
  requirements    String?
  responsibilities String?
  status          CareerOpeningStatus @default(DRAFT)
  applicationEmail String?
  applicationUrl  String?
  deadline        DateTime?
  featuredImageId String?
  featuredImage   MediaAsset?         @relation("CareerOpeningImage", fields: [featuredImageId], references: [id])
  metaTitle       String?
  metaDescription String?
  noIndex         Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  applications    CareerApplication[]

  @@index([status])
  @@index([lang])
  @@index([deadline])
}

model CareerApplication {
  id              String            @id @default(cuid())
  careerOpening   CareerOpening     @relation(fields: [careerOpeningId], references: [id], onDelete: Cascade)
  careerOpeningId String
  
  fullName        String
  email           String
  phone           String
  coverLetter     String?
  resumeUrl       String?
  
  status          ApplicationStatus @default(SUBMITTED)
  adminNotes      String?
  
  hashedIp        String?
  hashedUserAgent String?
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([careerOpeningId])
  @@index([status])
  @@index([email])
}

// ============================================================
// MEDIA & ASSETS
// ============================================================

enum MediaStatus {
  AI_PLACEHOLDER
  REAL_APPROVED
  STOCK_LICENCED
  PRIVATE_INTERNAL
}

enum MediaDeletionState {
  ACTIVE
  PENDING_REMOTE_DELETE
  REMOTE_DELETE_FAILED
  REMOTE_DELETED
}

enum MediaResourceType {
  IMAGE
  VIDEO
  DOCUMENT
}

model MediaAsset {
  id       String      @id @default(cuid())
  publicId String?
  assetId  String?
  fileName String
  fileUrl  String
  fileSize Int?
  mimeType String?
  width    Int?
  height   Int?
  duration Float?
  altText  String?
  caption  String?
  folder   String? // e.g. "training", "hero", "stories"
  tags     String[]
  isPublic Boolean     @default(true)
  status   MediaStatus @default(AI_PLACEHOLDER)
  resourceType MediaResourceType
  
  deletionState         MediaDeletionState @default(ACTIVE)
  deletionRequestedAt   DateTime?
  remoteDeletedAt       DateTime?
  deletionAttempts      Int                @default(0)
  lastDeletionErrorCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  heroImages        CmsHeroSection[]  @relation("HeroImage")
  heroVideos        CmsHeroSection[]  @relation("HeroVideo")
  heroPosterImages  CmsHeroSection[]  @relation("HeroPosterImage")
  heroMobileImages  CmsHeroSection[]  @relation("HeroMobileImage")
  blockImages       CmsContentBlock[] @relation("BlockImage")
  blockVideos       CmsContentBlock[] @relation("BlockVideo")
  blockPosterImages CmsContentBlock[] @relation("BlockPosterImage")
  blockMobileImages CmsContentBlock[] @relation("BlockMobileImage")
  demandLogos       Demand[]          @relation("DemandCompanyLogo")
  demandFeaturedImages Demand[]     @relation("DemandFeaturedImage")
  demandDocuments   DemandDocument[]  @relation("DemandDocumentMedia")
  insightImages     InsightArticle[]  @relation("InsightImage")
  newsImages        NewsArticle[]     @relation("NewsImage")
  careerImages      CareerOpening[]   @relation("CareerOpeningImage")
  successStoryImages SuccessStory[]   @relation("SuccessStoryImage")

  @@index([folder])
  @@index([mimeType])
  @@index([status])
  @@index([resourceType])
  @@index([deletionState])
}

// ============================================================
// SEO
// ============================================================

model SEOPageMeta {
  id                 String  @id @default(cuid())
  pagePath           String  // e.g. "/about", "/employers"
  lang               String  @default("en")
  metaTitle          String?
  metaDescription    String?
  focusKeyword       String?
  canonicalUrl       String?
  ogImage            String?
  ogTitle            String?
  ogDescription      String?
  twitterTitle       String?
  twitterDescription String?
  schemaMarkup       Json? // JSON-LD schema data
  noIndex            Boolean @default(false)
  noFollow           Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pagePath, lang])
  @@index([pagePath])
  @@index([lang])
}

model Redirect {
  id          String  @id @default(cuid())
  source      String  @unique
  destination String
  statusCode  Int     @default(301) // 301 or 302
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
}

// ============================================================
// CONTACT & ENGAGEMENT
// ============================================================

model ContactSubmission {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String?
  message   String
  type      String    @default("general") // "general", "employer", "complaint"
  isRead    Boolean   @default(false)
  repliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String?
  isActive Boolean @default(true)

  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([email])
}

// ============================================================
// SYSTEM
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String // e.g. "create", "update", "delete", "login", "download"
  entity    String // e.g. "job", "lead", "candidate", "document"
  entityId  String?
  details   Json? // Additional context
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}

model SiteSetting {
  id    String  @id @default(cuid())
  key   String  @unique
  value Json
  group String? // e.g. "general", "contact", "social", "homepage"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
}

model NavigationItem {
  id       String           @id @default(cuid())
  label    String
  labelNe  String?
  href     String?
  parentId String?
  parent   NavigationItem?  @relation("NavChildren", fields: [parentId], references: [id])
  children NavigationItem[] @relation("NavChildren")
  location String           @default("header") // "header", "footer", "mega_menu"
  order    Int              @default(0)
  isActive Boolean          @default(true)

  icon          String?
  description   String?
  descriptionNe String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([location])
  @@index([order])
}

// ============================================================
// CMS ABSTRACTION
// ============================================================

model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  subtitle  String?
  status    String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hero   CmsHeroSection?
  blocks CmsContentBlock[]
}

model CmsHeroSection {
  id              String  @id @default(cuid())
  pageId          String  @unique
  page            CmsPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  eyebrow         String?
  richHeading     Json
  richDescription Json?

  imageId String?
  image   MediaAsset? @relation("HeroImage", fields: [imageId], references: [id], onDelete: SetNull)
  videoId String?
  video   MediaAsset? @relation("HeroVideo", fields: [videoId], references: [id], onDelete: SetNull)
  posterImageId String?
  posterImage   MediaAsset? @relation("HeroPosterImage", fields: [posterImageId], references: [id], onDelete: SetNull)
  mobileImageId String?
  mobileImage   MediaAsset? @relation("HeroMobileImage", fields: [mobileImageId], references: [id], onDelete: SetNull)

  overlayEnabled           Boolean @default(true)
  overlayOpacity           Int     @default(60)
  accessibilityDescription String?

  primaryCtaText   String?
  primaryCtaHref   String?
  secondaryCtaText String?
  secondaryCtaHref String?

  @@index([posterImageId])
  @@index([mobileImageId])
}

model CmsContentBlock {
  id        String  @id @default(cuid())
  blockKey  String
  blockType String
  pageId    String
  page      CmsPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  order     Int     @default(0)
  visible   Boolean @default(true)

  richHeading Json?
  content     Json

  imageId String?
  image   MediaAsset? @relation("BlockImage", fields: [imageId], references: [id], onDelete: SetNull)
  videoId String?
  video   MediaAsset? @relation("BlockVideo", fields: [videoId], references: [id], onDelete: SetNull)
  posterImageId String?
  posterImage   MediaAsset? @relation("BlockPosterImage", fields: [posterImageId], references: [id], onDelete: SetNull)
  mobileImageId String?
  mobileImage   MediaAsset? @relation("BlockMobileImage", fields: [mobileImageId], references: [id], onDelete: SetNull)

  @@index([videoId])
  @@index([posterImageId])
  @@index([mobileImageId])
}

model CmsContentRevision {
  id            String   @id @default(cuid())
  entityType    String
  entityId      String
  content       Json
  authorId      String
  author        User     @relation("RevisionsAuthor", fields: [authorId], references: [id])
  createdAt     DateTime @default(now())
  commitMessage String?
}
