{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "main": ".open-next/worker.js",
    "name": "smanpower-secure",
    // Set this to today's date
    "compatibility_date": "2026-07-30",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "smanpower-secure"
        }
    ],
    "r2_buckets": [
        {
            "binding": "NEXT_INC_CACHE_R2_BUCKET",
            "bucket_name": "seven-seas-next-cache-production"
        }
    ],
    "d1_databases": [
        {
            "binding": "NEXT_TAG_CACHE_D1",
            "database_name": "seven-seas-next-tag-cache-production",
            "database_id": "1bc83d0c-0492-445c-b82a-7633f514e8fb"
        }
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "NEXT_CACHE_DO_QUEUE",
                "class_name": "DOQueueHandler"
            }
        ]
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["DOQueueHandler"]
        }
    ],
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
            "enabled": true,
            "invocation_logs": true
        }
    },
    // Non-secret runtime config. Secrets stay in `wrangler secret put`.
    // Booleans are quoted strings on purpose: the code compares against
    // the literals "true"/"false" (e.g. PRISMA_QUERY_LOGGING === "true").
    "vars": {
        "ADMIN_NOTIFICATION_EMAIL": "admin@smanpower.com",
        "APP_ENV": "production",
        "AUTH_URL": "https://smanpower.com",
        "DEMO_MODE": "false",
        "EMAIL_FROM": "Seven Seas Intercontinental <admin@notify.smanpower.com>",
        "EMAIL_PROVIDER": "resend",
        "LOG_LEVEL": "info",
        "NEXT_PUBLIC_APP_URL": "https://smanpower.com",
        "NEXT_PUBLIC_SITE_NAME": "Seven Seas Intercontinental",
        "NEXT_PUBLIC_SITE_URL": "https://smanpower.com",
        "NEXT_PUBLIC_TURNSTILE_ENABLED": "true",
        "PRISMA_QUERY_LOGGING": "false",
        "PUBLIC_APPLICATIONS_ENABLED": "true",
        "QA_MODE": "false",
        "RATE_LIMIT_ENABLED": "true",
        "SITE_URL": "https://smanpower.com",
        "STAGING_NOINDEX": "false",
        "STORAGE_PROVIDER": "cloudinary",
        "TURNSTILE_ENABLED": "true"
    }
}
