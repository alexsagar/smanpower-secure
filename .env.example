# Safe example only. Never put real secrets in this file.

# Runtime
NODE_ENV="development"
APP_ENV="local"
TRUSTED_PROXY_MODE="direct" # Options: local, direct, vercel, cloudflare, bluehost
DEMO_MODE="true"
QA_MODE="false"
PUBLIC_APPLICATIONS_ENABLED="false"
STAGING_NOINDEX="false"

# Database
# Neon pooled URL for application runtime.
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require"
# Neon direct/non-pooled URL for Prisma migrations.
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require"

# Auth.js / NextAuth
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Public site URLs
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Seven Seas Intercontinental"
NEXT_PUBLIC_WHATSAPP_NUMBER="+9779800000000"

# Security secrets
MFA_ENCRYPTION_KEY=""
PRIVACY_HASH_SECRET=""
ALLOW_DEV_INVITE_LINK_OUTPUT="false"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER_PREFIX=""

# Storage
STORAGE_PROVIDER="cloudinary"
PRIVATE_UPLOAD_DIR="./private-uploads"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""

# Upstash Redis / rate limiting
RATE_LIMIT_ENABLED="false"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_ENABLED="false"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_ENABLED="false"
TURNSTILE_SECRET_KEY=""

# Email
EMAIL_PROVIDER="smtp"
EMAIL_FROM="Seven Seas Intercontinental <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Seven Seas Intercontinental <no-reply@example.com>"
RESEND_API_KEY=""

# Admin bootstrap scripts
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-local-only"
QA_TEST_PASSWORD="QaTestPass123!"

# Optional analytics/maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Logging / Prisma
PRISMA_QUERY_LOGGING="false"
LOG_LEVEL="info"
