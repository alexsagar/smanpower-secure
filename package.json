{
  "name": "smanpower",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "build:production:safe": "node scripts/build-production-safe.mjs",
    "deploy:production:safe": "node scripts/deploy-production-safe.mjs",
    "build:production:ci": "node scripts/build-production-ci.mjs",
    "deploy:production:ci": "node scripts/deploy-production-ci.mjs",
    "production:preflight": "node scripts/production-preflight.mjs",
    "production:sanity": "node scripts/production-content-sanity.mjs",
    "production:verify-build": "node scripts/verify-generated-build.mjs",
    "production:smoke-test": "node scripts/production-smoke-test.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev": "next dev",
    "build": "prisma generate && node scripts/prisma-workerd-exports.mjs && opennextjs-cloudflare build",
    "migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate && node scripts/prisma-workerd-exports.mjs",
    "start": "next start",
    "lint": "eslint .",
    "seed:cms-from-demo": "npx tsx prisma/seed-cms.ts",
    "seed:partners": "npx tsx src/scripts/seed-partners.ts",
    "cms:export": "npx tsx src/scripts/cms-export.ts",
    "cms:import": "npx tsx src/scripts/cms-import.ts",
    "cms:audit": "npx tsx src/scripts/cms-audit.ts",
    "cms:repair-statistics": "npx tsx src/scripts/cms-repair-statistics.ts",
    "cms:update-statistics": "node scripts/update-production-cms-statistics.mjs",
    "cms:migrate-dynamic-pages": "npx tsx src/scripts/cms-migrate-dynamic-pages.ts",
    "cms:migrate-page-copy": "npx tsx src/scripts/cms-migrate-page-copy.ts",
    "admin:set-super-admin": "npx tsx src/scripts/set-super-admin.ts",
    "admin:create-user": "npx tsx src/scripts/create-user.ts",
    "admin:unlock-user": "npx tsx src/scripts/unlock-user.ts",
    "admin:invite-super-admin": "npx tsx src/scripts/invite-super-admin.ts",
    "admin:rbac-audit": "npx tsx src/scripts/rbac-audit.ts",
    "admin:rbac-sync": "npx tsx src/scripts/rbac-sync.ts",
    "admin:media-orphan-audit": "npx tsx src/scripts/media-orphan-cleanup.ts --dry-run",
    "admin:media-orphan-cleanup": "npx tsx src/scripts/media-orphan-cleanup.ts --execute",
    "email:test": "npx tsx src/scripts/email-test.ts",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:integration": "dotenv -e .env.test -- vitest run tests/integration",
    "test:seo": "vitest run src/app/sitemap.test.ts src/app/robots.test.ts src/app/staging-seo.test.ts src/app/llms.txt/route.test.ts src/lib/seo src/config/approved-content.test.ts src/services/search.service.test.ts src/lib/demand-eligibility.test.ts",
    "test:deployment": "vitest run tests/production-safety.test.ts tests/deployment/incident2-clean-build.test.ts tests/deployment/automatic-deployment-safety.test.ts tests/deployment/safe-cms-runner.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build:cloudflare": "npm run build",
    "test:watch": "vitest",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
    "qa:guard": "npx tsx src/scripts/qa-guard.ts",
    "qa:validate": "dotenv -e .env.test -- npm run qa:guard && dotenv -e .env.test -- npx prisma validate",
    "qa:migrate": "dotenv -e .env.test -- npm run qa:guard && dotenv -e .env.test -- npx prisma migrate deploy",
    "qa:seed": "dotenv -e .env.test -- npm run qa:guard && dotenv -e .env.test -- npx tsx prisma/qa-seed.ts",
    "qa:lint": "npm run lint",
    "qa:test": "dotenv -e .env.test -- vitest run",
    "qa:build": "dotenv -e .env.test -- npm run qa:guard && dotenv -e .env.test -- npx prisma generate && dotenv -e .env.test -- next build",
    "qa:static": "npm run qa:validate && npm run qa:lint && npm run qa:test && npm run qa:build",
    "qa:e2e": "npm run qa:seed && npm run qa:build && dotenv -e .env.test -- playwright test",
    "qa": "npm run qa:static && npm run qa:e2e",
    "vercel-build": "npm run build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@next/env": "^16.2.10",
    "@opennextjs/cloudflare": "^1.20.2",
    "@prisma/adapter-neon": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@tiptap/core": "^3.27.2",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.23.0",
    "nepal-district-map": "^1.1.0",
    "next": "16.2.9",
    "next-auth": "^5.0.0-beta.31",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "react-zoom-pan-pinch": "^4.0.3",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "speakeasy": "^2.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/speakeasy": "^2.0.10",
    "@vitejs/plugin-react": "^6.0.4",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
